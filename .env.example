# Copy to .env and fill in. See README.md for setup instructions.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/surplus_flooring?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Stripe (test mode keys to start: https://dashboard.stripe.com/test/apikeys)
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create for
# /api/stripe/webhook (Stripe CLI: `stripe listen --forward-to localhost:3000/api/stripe/webhook`).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Object storage for listing photos and verification docs. Any S3-compatible
# provider works: AWS S3, Cloudflare R2, Backblaze B2, or a local MinIO/s3rver
# for development. Leave blank to disable uploads (everything else still runs).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="surplus-flooring-listings"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Optional — real geocoding via Mapbox. Without this, listing locations
# resolve from a small built-in table of major Canadian cities.
MAPBOX_TOKEN=""

# Email (Resend: https://resend.com). Without this, emails are logged to the
# server console instead of sent — fine for local development.
RESEND_API_KEY=""
EMAIL_FROM="Surplus Flooring Marketplace <no-reply@yourdomain.com>"

# Shared secret for the auto-release cron job (Vercel Cron sends this as a
# Bearer token — see vercel.json). Generate with: openssl rand -hex 32
CRON_SECRET=""

# Platform defaults — only used the first time PlatformConfig is read; after
# that, admins can change these live at /admin/config.
PLATFORM_COMMISSION_PERCENT="8"
FUND_RELEASE_WINDOW_DAYS="5"

# Public URL of the deployed app (used in emails and Stripe redirect URLs).
APP_BASE_URL="http://localhost:3000"

# Optional — used only by `npm run db:seed` to create the first admin user.
SEED_ADMIN_EMAIL="admin@surplusflooring.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"
