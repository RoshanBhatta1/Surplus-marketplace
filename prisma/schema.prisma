// Surplus Flooring Marketplace — data model
// Build order per brief: data model is confirmed before any payment/transaction
// logic is written, since money-moving code is the hardest layer to change later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  NONE
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  name            String
  phone           String?
  phoneVerifiedAt DateTime?

  accountType AccountType @default(INDIVIDUAL)
  status      UserStatus  @default(ACTIVE)
  adminRole   AdminRole   @default(NONE)

  // Business verification — trust signal only, not a permission gate in v1.
  businessName         String?
  businessNumber       String?
  insuranceDocumentUrl String?
  businessVerifiedAt   DateTime?

  // Default location, used for pickup-radius search and as listing default.
  city       String?
  region     String?
  postalCode String?
  latitude   Float?
  longitude  Float?

  // Stripe Connect (seller payouts)
  stripeConnectAccountId      String? @unique
  stripeConnectOnboarded      Boolean @default(false)
  stripeConnectPayoutsEnabled Boolean @default(false)

  // Stripe Customer (buyer payment methods)
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings                Listing[]                @relation("SellerListings")
  offersMade              Offer[]                  @relation("BuyerOffers")
  transactionsBought      Transaction[]            @relation("BuyerTransactions")
  transactionsSold        Transaction[]            @relation("SellerTransactions")
  reviewsWritten          Review[]                 @relation("ReviewAuthor")
  reviewsReceived         Review[]                 @relation("ReviewSubject")
  reportsFiled            Report[]                 @relation("ReportedBy")
  reportsAgainst          Report[]                 @relation("ReportedUser")
  disputesFiled           Dispute[]                @relation("DisputeFiledBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  phoneVerificationCodes  PhoneVerificationCode[]
  adminActions            AdminAction[]            @relation("AdminActor")
  notifications           Notification[]

  @@index([accountType])
  @@index([status])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PhoneVerificationCode {
  id        String   @id @default(cuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

enum MaterialType {
  CARPET_TILE
  BROADLOOM_CARPET
  LVT_LVP
  HARDWOOD
  LAMINATE
  CERAMIC_PORCELAIN_TILE
  RESILIENT_SHEET
  RUBBER_FLOORING
  TRIM_TRANSITION_PROFILE
  ADHESIVE_LEVELING_COMPOUND
  UNDERLAYMENT
  OTHER
}

enum ListingCondition {
  NEW_SEALED_BOX
  OPEN_BOX_SURPLUS
  TAKE_UP_USED
}

enum UnitOfMeasure {
  SQ_FT
  BOXES
  ROLLS
  SHEETS
  PALLETS
  LINEAR_FT
}

enum ListingType {
  FIXED_PRICE
  BEST_OFFER
  BULK_LOT
}

enum FulfillmentOption {
  LOCAL_PICKUP
  SELLER_SHIPPING
  BOTH
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  REMOVED
  SUSPENDED
}

model Listing {
  id       String @id @default(cuid())
  sellerId String
  seller   User   @relation("SellerListings", fields: [sellerId], references: [id])

  title String

  // Precision fields — the core differentiator for this vertical.
  manufacturer String
  productLine  String
  colorName    String
  colorNumber  String
  dyeLotNumber String? // optional; UI must plainly show "no dye lot on file" when null

  materialType MaterialType
  condition    ListingCondition

  unitOfMeasure UnitOfMeasure
  quantity      Decimal       @db.Decimal(12, 2)

  pricePerUnit Decimal @db.Decimal(12, 2)
  totalPrice   Decimal @db.Decimal(12, 2)
  currency     String  @default("CAD")

  listingType   ListingType @default(FIXED_PRICE)
  minOfferPrice Decimal?    @db.Decimal(12, 2) // floor sellers will consider for BEST_OFFER

  fulfillmentOption FulfillmentOption @default(LOCAL_PICKUP)
  flatShippingFee   Decimal?          @db.Decimal(12, 2) // required if SELLER_SHIPPING/BOTH

  // Location for pickup-radius search.
  city       String
  region     String
  postalCode String
  latitude   Float
  longitude  Float

  description String? @db.Text

  status ListingStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  soldAt    DateTime?

  images       ListingImage[]
  offers       Offer[]
  transactions Transaction[]
  reports      Report[]

  @@index([manufacturer])
  @@index([materialType])
  @@index([condition])
  @@index([status])
  @@index([pricePerUnit])
  @@index([latitude, longitude])
  @@index([createdAt])
}

enum ListingImageKind {
  PHOTO
  DYE_LOT_LABEL
}

model ListingImage {
  id        String           @id @default(cuid())
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  kind      ListingImageKind @default(PHOTO)
  position  Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Offers (for BEST_OFFER / BULK_LOT listings)
// ---------------------------------------------------------------------------

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model Offer {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User    @relation("BuyerOffers", fields: [buyerId], references: [id])

  amount   Decimal     @db.Decimal(12, 2) // proposed total price
  quantity Decimal     @db.Decimal(12, 2)
  status   OfferStatus @default(PENDING)

  // Counter-offer thread: self-relation to the offer being responded to.
  respondsToId String?
  respondsTo   Offer?  @relation("OfferThread", fields: [respondsToId], references: [id])
  responses    Offer[] @relation("OfferThread")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  transaction Transaction?

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Transactions — escrow hold/release state machine
// ---------------------------------------------------------------------------

enum TransactionStatus {
  PENDING_PAYMENT // checkout started, payment not yet captured
  FUNDS_HELD // payment captured, held pending buyer confirmation
  DISPUTED // buyer flagged a dispute; auto-release paused
  RELEASED // seller paid out
  REFUNDED // refunded to buyer (dispute resolution or cancellation)
  CANCELLED // cancelled before payment capture
}

enum FulfillmentMethod {
  LOCAL_PICKUP
  SELLER_SHIPPING
}

model Transaction {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("SellerTransactions", fields: [sellerId], references: [id])

  offerId String? @unique
  offer   Offer?  @relation(fields: [offerId], references: [id])

  quantity     Decimal @db.Decimal(12, 2)
  itemSubtotal Decimal @db.Decimal(12, 2)
  shippingFee  Decimal @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2) // itemSubtotal + shippingFee, what buyer pays
  currency     String  @default("CAD")

  commissionPercent  Decimal @db.Decimal(5, 2) // snapshot of platform commission at sale time
  commissionAmount   Decimal @db.Decimal(12, 2)
  sellerPayoutAmount Decimal @db.Decimal(12, 2) // totalAmount - commissionAmount

  fulfillmentMethod FulfillmentMethod

  status TransactionStatus @default(PENDING_PAYMENT)

  // Stripe references
  stripePaymentIntentId String? @unique
  stripeTransferId      String? @unique
  stripeRefundId        String?

  fundsReleaseDueAt DateTime? // set on FUNDS_HELD; auto-release deadline
  paidAt            DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  cancelledAt       DateTime?
  buyerConfirmedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review       Review?
  dispute      Dispute?
  statusEvents TransactionStatusEvent[]

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([fundsReleaseDueAt])
}

// Append-only audit trail of every status transition — needed for dispute
// resolution and support, and to reconstruct what happened to a payment.
model TransactionStatusEvent {
  id            String             @id @default(cuid())
  transactionId String
  transaction   Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  note          String?
  createdAt     DateTime           @default(now())

  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  authorId  String
  author    User   @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id])

  rating  Int // 1-5
  comment String? @db.Text

  createdAt DateTime @default(now())

  @@index([subjectId])
}

// ---------------------------------------------------------------------------
// Trust & safety
// ---------------------------------------------------------------------------

enum ReportTargetType {
  LISTING
  USER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id             String           @id @default(cuid())
  targetType     ReportTargetType
  listingId      String?
  listing        Listing?         @relation(fields: [listingId], references: [id])
  reportedUserId String?
  reportedUser   User?            @relation("ReportedUser", fields: [reportedUserId], references: [id])

  reportedById String
  reportedBy   User   @relation("ReportedBy", fields: [reportedById], references: [id])

  reason  String
  details String?      @db.Text
  status  ReportStatus @default(OPEN)

  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text

  @@index([status])
  @@index([targetType])
}

enum DisputeStatus {
  OPEN
  RESOLVED_RELEASE_TO_SELLER
  RESOLVED_REFUND_TO_BUYER
  RESOLVED_PARTIAL
}

model Dispute {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  filedById String
  filedBy   User   @relation("DisputeFiledBy", fields: [filedById], references: [id])

  reason  String
  details String        @db.Text
  status  DisputeStatus @default(OPEN)

  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text
  resolvedById   String?

  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin / platform config
// ---------------------------------------------------------------------------

enum AdminActionType {
  LISTING_REMOVED
  LISTING_RESTORED
  USER_SUSPENDED
  USER_REINSTATED
  REPORT_RESOLVED
  DISPUTE_RESOLVED
  CONFIG_CHANGED
}

model AdminAction {
  id        String          @id @default(cuid())
  actorId   String
  actor     User            @relation("AdminActor", fields: [actorId], references: [id])
  type      AdminActionType
  targetId  String? // free-form id of the listing/user/report/dispute affected
  note      String?         @db.Text
  createdAt DateTime        @default(now())

  @@index([type])
}

// Singleton row (id is always 1) holding platform-wide config values.
model PlatformConfig {
  id                    Int      @id @default(1)
  commissionPercent     Decimal  @default(8.00) @db.Decimal(5, 2)
  fundReleaseWindowDays Int      @default(5)
  updatedAt             DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
